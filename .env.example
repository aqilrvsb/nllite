# Copy to .env.local (local) or set in Vercel (production).
# Supabase project: nllegacy-tasks
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Server-only secret — full access, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Long random string used to sign the login session cookie.
SESSION_SECRET=change-me-to-a-long-random-string
